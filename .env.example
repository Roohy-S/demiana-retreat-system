# ==============================================================================
# إعدادات نظام بيت الخلوة بدير القديسة دميانة – ببراري بلقاس
# DEMIANA RETREAT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. إعدادات قاعدة بيانات سوبابيز (Supabase PostgreSQL Connection URI)
# يمكنك الحصول على هذا الرابط من لوحة تحكم Supabase: Settings -> Database -> Connection string -> URI
# مثال:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# 2. إعدادات البريد الإلكتروني الحقيقي (Gmail SMTP Configuration)
# لإرسال رسائل التحقق (OTP) ورسائل القبول إلى بريد المتقدمات الفعلي:
# 1- قم بتفعيل التحقق بخطوتين (2-Step Verification) في حساب Google الخاص بالدير/المسؤول.
# 2- توجه إلى: myaccount.google.com/apppasswords وأنشئ "كلمة مرور تطبيقات" جديدة (App Password).
# 3- ضع بريدك وكلمة المرور المكونة من 16 حرفاً هنا:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_NAME=بيت الخلوة – دير القديسة دميانة ببراري بلقاس
REQUIRE_EMAIL_VERIFICATION=True

# 3. الأمان وتشفير التوكن
SECRET_KEY=demiana_monastery_retreat_super_secret_jwt_key_2026_prod
